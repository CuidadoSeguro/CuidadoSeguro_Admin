{
	"info": {
		"_postman_id": "b8e2c4a1-5d7f-4a3b-9e1c-2f6d8a0b4c9e",
		"name": "msal-api",
		"description": "API Spring Boot + JWT Entra ID (DSY1107).\n\n1. Arranca msal-front, inicia sesion y copia el Access Token (no el ID Token).\n2. En esta coleccion: Variables -> accessToken -> pega el JWT.\n3. Ejecuta los 3 requests en orden.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. GET public/hola - sin token - 200",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test('Mensaje publico', function () {",
							"    var body = pm.response.json();",
							"    pm.expect(body.mensaje).to.eql('API pública: no se pidió token.');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"auth": {
					"type": "noauth"
				},
				"method": "GET",
				"header": [],
				"url": "{{baseUrl}}/public/hola",
				"description": "Endpoint publico. Sin Authorization. Esperado: 200."
			},
			"response": []
		},
		{
			"name": "2. GET api/me - sin token - 401",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status 401', function () {",
							"    pm.response.to.have.status(401);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"auth": {
					"type": "noauth"
				},
				"method": "GET",
				"header": [],
				"url": "{{baseUrl}}/api/me",
				"description": "Ruta privada sin Bearer. Esperado: 401."
			},
			"response": []
		},
		{
			"name": "3. GET api/me - con access token - 200",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test('Claims del JWT', function () {",
							"    var body = pm.response.json();",
							"    pm.expect(body.mensaje).to.eql('API privada: el access token es válido.');",
							"    pm.expect(body).to.have.property('sub');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{accessToken}}",
							"type": "string"
						}
					]
				},
				"method": "GET",
				"header": [],
				"url": "{{baseUrl}}/api/me",
				"description": "Pega el Access Token de msal-front en la variable accessToken. Esperado: 200."
			},
			"response": []
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080"
		},
		{
			"key": "accessToken",
			"value": ""
		}
	]
}
