# Copia este archivo a .env y completa los valores locales. No subas .env al repositorio.

# Puerto del servicio
SERVER_PORT=8080

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cuidadoseguro
DB_USERNAME=root
DB_PASSWORD=
DB_USE_SSL=false
JPA_DDL_AUTO=update
# Usa "always" solo la primera vez si quieres cargar src/main/resources/data.sql
SQL_INIT_MODE=never

# Microsoft Entra ID (resource server)
AZURE_ISSUER_URI=https://login.microsoftonline.com/<tenant-id>/v2.0
AZURE_CLIENT_ID=<application-client-id>

# Orígenes permitidos por CORS (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4200

# Nivel de log para OAuth2 (INFO en producción, DEBUG para depurar tokens)
LOG_LEVEL_OAUTH2=INFO
