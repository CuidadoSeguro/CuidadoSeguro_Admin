# Copia este archivo como .env y completa los valores de tu entorno.
SERVER_PORT=8080

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=administracion
DB_USERNAME=root
DB_PASSWORD=
DB_USE_SSL=false
JPA_DDL_AUTO=update
SQL_INIT_MODE=never

# Microsoft Entra ID: debe coincidir con el emisor y audiencia del Access Token de tu API.
AZURE_ISSUER_URI=https://login.microsoftonline.com/95cd823a-c239-4ece-b6ea-932724964971/v2.0
AZURE_CLIENT_ID=3912eb25-8b20-4725-9b9d-18a99c419ead

# Amazon Cognito: App Client PÚBLICO sin client secret.
COGNITO_ISSUER_URI=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_RP2GidqrX
COGNITO_CLIENT_ID=REEMPLAZAR_POR_APP_CLIENT_ID_PUBLICO
COGNITO_USER_POOL_ID=us-east-1_RP2GidqrX
COGNITO_PATIENT_GROUP=PACIENTE
AWS_REGION=us-east-1
# SOLO DESARROLLO LOCAL: crea credenciales IAM limitadas a este User Pool.
# Nunca subas estos valores a Git ni los pongas en Angular.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Opcional: solo para credenciales temporales (STS).
AWS_SESSION_TOKEN=
# En producción, elimina estas tres variables y utiliza un IAM Role.

# Frontend local y despliegue. Agrega aquí los orígenes reales que utilices.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:5173

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_SIGNOS_VITALES=signos-vitales
NOTIFICACION_SERVICE_URL=http://localhost:8089
QUEUES_SERVICE_URL=http://localhost:8086
LOG_LEVEL_OAUTH2=INFO
