# Copia este archivo como .env para desarrollo local.
# No subas .env al repositorio ni pongas contraseñas reales en .env.example.

SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# Base de datos local (ajusta según tu instalación)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=msal_api
DB_USERNAME=root
DB_PASSWORD=
# Alternativa: define DB_URL completa y tendrá prioridad sobre DB_HOST/DB_PORT/DB_NAME
# DB_URL=jdbc:mysql://localhost:3306/msal_api?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true

# Microsoft Entra ID
ENTRA_ISSUER_URI=https://login.microsoftonline.com/95cd823a-c239-4ece-b6ea-932724964971/v2.0
ENTRA_API_AUDIENCE=3912eb25-8b20-4725-9b9d-18a99c419ead

SECURITY_LOG_LEVEL=DEBUG
